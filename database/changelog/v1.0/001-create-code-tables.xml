<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ==========================================
         Code Tables (code_types, codes)
         ========================================== -->

    <changeSet id="001-01-create-code-types" author="system">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="code_types"/></not>
        </preConditions>

        <createTable tableName="code_types" remarks="Code type master data with multi-language support">
            <column name="id" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name_en" type="varchar(200)"/>
            <column name="name_ko" type="varchar(200)"/>
            <column name="name_zh" type="varchar(200)"/>
            <column name="name_vi" type="varchar(200)"/>
            <column name="description_en" type="${clob.type}"/>
            <column name="description_ko" type="${clob.type}"/>
            <column name="description_zh" type="${clob.type}"/>
            <column name="description_vi" type="${clob.type}"/>
            <column name="display_order" type="int"/>
            <column name="status" type="varchar(20)"/>
            <column name="category" type="varchar(50)"/>
            <column name="created_at" type="${timestamp.type}"/>
            <column name="updated_at" type="${timestamp.type}"/>
        </createTable>
    </changeSet>

    <changeSet id="001-02-create-codes" author="system">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="codes"/></not>
        </preConditions>

        <createTable tableName="codes" remarks="Code master data with multi-language support">
            <column name="id" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code_type_id" type="varchar(100)" remarks="Reference to code_types.id"/>
            <column name="code_type" type="varchar(100)" remarks="Deprecated: Use code_type_id instead"/>
            <column name="code" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="name_en" type="varchar(200)"/>
            <column name="name_ko" type="varchar(200)"/>
            <column name="name_zh" type="varchar(200)"/>
            <column name="name_vi" type="varchar(200)"/>
            <column name="description_en" type="${clob.type}"/>
            <column name="description_ko" type="${clob.type}"/>
            <column name="description_zh" type="${clob.type}"/>
            <column name="description_vi" type="${clob.type}"/>
            <column name="display_order" type="int"/>
            <column name="status" type="varchar(20)"/>
            <column name="parent_code" type="varchar(100)"/>
            <column name="attributes" type="${json.type}"/>
            <column name="created_at" type="${timestamp.type}"/>
            <column name="updated_at" type="${timestamp.type}"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
