# App Service Environment Variables

# Server
NODE_ENV=development
PORT=3012

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corenext
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# Redis (optional)
REDIS_URL=redis://localhost:6379
