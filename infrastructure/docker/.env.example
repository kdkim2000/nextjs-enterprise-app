# Docker Compose 환경 변수 (서버용)
# 이 파일을 .env로 복사하여 실제 값을 설정하세요
#
# MSA 구조 (2개 서비스):
#   - core-service (Port 3011): Auth + Admin + Common
#   - app-service (Port 3012): Content + Communication

# ===========================================
# Database (PostgreSQL)
# ===========================================
DB_HOST=corenext-postgres
DB_PORT=5432
DB_NAME=corenextdb
DB_USER=corenext
DB_PASSWORD=your-secure-db-password

# ===========================================
# JWT (인증 토큰)
# ===========================================
# 64바이트 이상의 강력한 랜덤 문자열 사용 권장
JWT_SECRET=your-jwt-secret-key-at-least-64-bytes-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-at-least-64-bytes-long

# ===========================================
# Redis (세션/토큰 관리)
# ===========================================
REDIS_PASSWORD=your-secure-redis-password

# ===========================================
# CORS (허용 도메인)
# ===========================================
CORS_ORIGINS=https://your-domain.com,http://localhost:3000

# ===========================================
# Monitoring (Grafana)
# ===========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password
GRAFANA_ROOT_URL=http://localhost:3100

# ===========================================
# APISIX (임시 비활성화)
# ===========================================
# APISIX_ADMIN_KEY=your-apisix-admin-key
