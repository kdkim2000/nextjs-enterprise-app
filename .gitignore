# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend runtime data (logs, user activity, etc.)
backend/data/logs.json
backend/data/userPreferences.json
backend/data/users.json
backend/data/userRoleMappings.json
backend/data/tokenBlacklist.json
backend/data/mfaCodes.json

# migration sensitive data
migration/migrate.config.json
migration/node_modules/
migration/*.log
migration/test-connection.js
migration/.env
migration/.env.*
migration/insert_conversations*.sql

# database backups
migration/*.dump
migration/*.sql.backup
*.backup
backup/

# PostgreSQL
.pgpass
pgdata/

# claude settings (local only)
.claude/
migration/.claude/

# Note: docs/claude-sessions/ is now shared (sanitized)
# Run docs/claude-sessions/sanitize.py before committing new sessions

# Uploaded files
uploads/

# Services (MSA)
services/*/node_modules/
services/*/dist/
services/*/*.log

# Shared library
shared/node_modules/
shared/dist/

# Infrastructure
infrastructure/*/data/
infrastructure/*/logs/
docker/ssl/
infrastructure/*/ssl/

.vercel

# Runtime logs
logs/

# Supabase CLI temp state
supabase/.temp/
